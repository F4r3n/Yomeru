# Sources for the binary dictionary indexes.
#
# Read by `xtask/src/main.rs` (via include_str!) and by
# `server/Dockerfile` (sourced as a shell env file). Keeping both
# consumers pointed at one file means the Dockerfile can pre-fetch
# the inputs in its own cacheable layer without duplicating URLs.
#
# Each source has two keys:
#   <NAME>_URL — gzipped upstream URL
#   <NAME>_OUT — filename of the decompressed file inside the
#                workspace root (what the xtask `build-*` commands
#                expect as their --input path)
# and optionally:
#   <NAME>_FALLBACK_URL — tried when <NAME>_URL fails, on every attempt
#
# EDRDG fallbacks: HTTPS to edrdg.org times out at connect from GitHub
# Actions runners, while plain HTTP to ftp.edrdg.org (same server) works
# there; yomidevs/jmdict-yomitan downloads it that way daily. HTTP is
# unauthenticated, so it only serves as the fallback. (ftp.edrdg.org's TLS
# cert doesn't cover that name, hence www. for the HTTPS URL.)

JMDICT_URL=https://www.edrdg.org/pub/Nihongo/JMdict_e.gz
JMDICT_FALLBACK_URL=http://ftp.edrdg.org/pub/Nihongo/JMdict_e.gz
JMDICT_OUT=JMdict_e

KANJIDIC_URL=https://www.edrdg.org/pub/Nihongo/kanjidic2.xml.gz
KANJIDIC_FALLBACK_URL=http://ftp.edrdg.org/pub/Nihongo/kanjidic2.xml.gz
KANJIDIC_OUT=kanjidic2

EXAMPLES_URL=https://www.edrdg.org/pub/Nihongo/examples.utf.gz
EXAMPLES_FALLBACK_URL=http://ftp.edrdg.org/pub/Nihongo/examples.utf.gz
EXAMPLES_OUT=examples.utf

# KanjiVG publishes from GitHub releases rather than EDRDG; pinned to a
# release so rebuilds are reproducible.
KANJIVG_URL=https://github.com/KanjiVG/kanjivg/releases/download/r20260714/kanjivg-20260714.xml.gz
KANJIVG_OUT=kanjivg.xml
